from logic import *

# Define symbols for each character
AKnight = Symbol("A is a Knight")
AKnave = Symbol("A is a Knave")

BKnight = Symbol("B is a Knight")
BKnave = Symbol("B is a Knave")

CKnight = Symbol("C is a Knight")
CKnave = Symbol("C is a Knave")

# Puzzle 0
# A says "I am both a knight and a knave."
knowledge0 = And(
    # A must be either a Knight or a Knave, but not both
    Or(AKnight, AKnave),
    Not(And(AKnight, AKnave)),

    # If A is a Knight, then A's statement ("I am both a knight and a knave") must be true
    Implication(AKnight, And(AKnight, AKnave)),

    # If A is a Knave, then A's statement must be false
    Implication(AKnave, Not(And(AKnight, AKnave)))
)

# Puzzle 1
# A says "We are both knaves."
knowledge1 = And(
    # A and B must each be either a Knight or a Knave, but not both
    Or(AKnight, AKnave),
    Not(And(AKnight, AKnave)),

    Or(BKnight, BKnave),
    Not(And(BKnight, BKnave)),

    # If A is a Knight, then the statement "A and B are both Knaves" must be true
    Implication(AKnight, And(AKnave, BKnave)),

    # If A is a Knave, then the statement "A and B are both Knaves" must be false
    Implication(AKnave, Not(And(AKnave, BKnave)))
)

# Puzzle 2
# A says "We are the same kind."
# B says "We are of different kinds."
knowledge2 = And(
    # A and B must each be either a Knight or a Knave, but not both
    Or(AKnight, AKnave),
    Not(And(AKnight, AKnave)),

    Or(BKnight, BKnave),
    Not(And(BKnight, BKnave)),

    # If A is a Knight, then A and B must be the same kind
    Implication(AKnight, Or(
        And(AKnight, BKnight),
        And(AKnave, BKnave)
    )),

    # If A is a Knave, then A and B must not be the same kind
    Implication(AKnave, Not(Or(
        And(AKnight, BKnight),
        And(AKnave, BKnave)
    ))),

    # If B is a Knight, then A and B must be different kinds
    Implication(BKnight, Or(
        And(AKnight, BKnave),
        And(AKnave, BKnight)
    )),

    # If B is a Knave, then A and B must not be different kinds
    Implication(BKnave, Not(Or(
        And(AKnight, BKnave),
        And(AKnave, BKnight)
    )))
)

# Puzzle 3
# A says either "I am a Knight." or "I am a Knave." (unknown which)
# B says "A said 'I am a Knave.'" and "C is a Knave."
# C says "A is a Knight."
knowledge3 = And(
    # A, B, and C must each be either a Knight or a Knave, but not both
    Or(AKnight, AKnave),
    Not(And(AKnight, AKnave)),

    Or(BKnight, BKnave),
    Not(And(BKnight, BKnave)),

    Or(CKnight, CKnave),
    Not(And(CKnight, CKnave)),

    # B says "A said 'I am a knave.'"
    # If B is a Knight, then it is true that A said "I am a knave."
    # (Meaning: If A said "I am a knave," we consider the consequences.)
    Implication(BKnight, 
        # Two possibilities:
        # If A is a Knight, and says "I am a Knave", it would be a lie (impossible for Knight)
        # If A is a Knave, and says "I am a Knave", it would be a lie (Knave lies)
        # So if B is a Knight, then A must have said "I am a Knave" meaning A is a Knave
        AKnave
    ),

    # If B is a Knave, then it is false that A said "I am a Knave"
    Implication(BKnave,
        Not(AKnave)
    ),

    # B says "C is a Knave."
    # If B is a Knight, then C is a Knave
    Implication(BKnight, CKnave),

    # If B is a Knave, then C is not a Knave (i.e., C is a Knight)
    Implication(BKnave, CKnight),

    # C says "A is a Knight."
    # If C is a Knight, then A is a Knight
    Implication(CKnight, AKnight),

    # If C is a Knave, then A is not a Knight (i.e., A is a Knave)
    Implication(CKnave, AKnave)
)


def main():
    symbols = [AKnight, AKnave, BKnight, BKnave, CKnight, CKnave]
    puzzles = [
        ("Puzzle 0", knowledge0),
        ("Puzzle 1", knowledge1),
        ("Puzzle 2", knowledge2),
        ("Puzzle 3", knowledge3)
    ]

    for puzzle_name, knowledge in puzzles:
        print(puzzle_name)
        for symbol in symbols:
            if model_check(knowledge, symbol):
                print(f"    {symbol}")


if __name__ == "__main__":
    main()
